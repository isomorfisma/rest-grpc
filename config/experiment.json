{
  "experiment": {
    "repetitions": 15,
    "block_size": 5,
    "warmup": "10s",
    "duration": "60s",
    "timeout": "30s",
    "pause_seconds": 5,
    "seed": 42
  },
  "record": {
    "description_chars": 936
  },
  "payload_classes": [
    {
      "name": "xs",
      "records": 1
    },
    {
      "name": "sm",
      "records": 50
    },
    {
      "name": "md",
      "records": 500
    },
    {
      "name": "lg",
      "records": 1500
    },
    {
      "name": "xl",
      "records": 3000
    }
  ],
  "concurrency_levels": [
    10,
    100,
    500
  ],
  "protocols": [
    {
      "name": "rest",
      "kind": "rest",
      "ip": "172.28.0.10",
      "port": 8443,
      "path": "/api/payload"
    },
    {
      "name": "grpc",
      "kind": "grpc",
      "ip": "172.28.0.11",
      "port": 9443,
      "call": "payload.PayloadService/GetPayload"
    }
  ],
  "network": {
    "subnet": "172.28.0.0/24",
    "bridge": "br-exp",
    "delay": "1ms",
    "rate": "10gbit",
    "limit": 10000
  },
  "resources": {
    "cpus": "1.0",
    "memory": "3G",
    "service_cpuset": "0,4",
    "generator_cpuset": "1-3,5-7",
    "gomemlimit": "2560MiB"
  },
  "monitoring": {
    "prometheus_url": "http://localhost:9090"
  },
  "output": {
    "raw_dir": "raw",
    "runlog": "data/runlog.csv",
    "data_dir": "data",
    "figures_dir": "figures"
  }
}
